# ─── IA OFFICE HUB : PRODUCTION ENVIRONMENT TEMPLATE ──────────
# COPIER CE FICHIER VERS '.env' SUR LE SERVEUR DE PROD

# ── AI Configuration ──────────────────────────────────────────
OPENAI_API_KEY=sk-votre-cle-de-production-ici
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# ── Security (ISO 27001 A.10) ─────────────────────────────────
# Remplacez par des clés uniques et longues !
SECRET_KEY=votre-cle-secrete-de-production-tres-longue
ENCRYPTION_KEY=votre-cle-de-chiffrement-aes-de-32-chars
AUDIT_SECRET_SALT=votre-sel-secret-pour-integrity-hashing

# ── Database ──────────────────────────────────────────────────
# En prod, on utilise souvent PostgreSQL, mais SQLite fonctionne dans un volume Docker.
DATABASE_URL=sqlite:///./database.db

# ── Application ───────────────────────────────────────────────
ENV=production
DEBUG=False
API_PREFIX=/api/v1
APP_NAME="IA Office Hub"
APP_VERSION="1.0.0-PROD"

# ── CORS ──────────────────────────────────────────────────────
# Remplacez par votre domaine réel
ALLOWED_ORIGINS=["https://votre-domaine.com"]

# ── LibreOffice UNO ──────────────────────────────
LIBREOFFICE_HOST=localhost
LIBREOFFICE_PORT=2002
LIBREOFFICE_TIMEOUT=60

# ── Stockage ──────────────────────────────────────────────────
# Chemins mappés vers les volumes Docker
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/output
MAX_FILE_SIZE_MB=100

# ── Logging & Audit (SOC 2 / ISO 27001) ──────────────────────
LOG_LEVEL=WARNING
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_YEARS=7
LOG_TO_FILE=True
LOG_FILE_PATH=/app/logs/audit.log
